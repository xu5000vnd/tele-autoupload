NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14

TG_API_ID=12345678
TG_API_HASH=abcdef1234567890
TG_SESSION_STRING=base64_session
TG_NUMBER=+66812345678
# Uses Telegram port 443 instead of direct MTProto on port 80. Set false only if required.
TG_USE_WSS=true
# tele_sync_upload_bot
BOT_TOKEN=8687835090:xxxxxx
BOT_REPORT_CHAT_ID=-5241895841 
# Comma/semicolon/newline-separated Telegram usernames (with or without @)
# to suppress "Unregistered uploader detected" notifications for group admins.
# Queued media from confirmed usernames is also skipped instead of retried.
UNREGISTERED_UPLOADER_USERNAME_WHITELIST=@admin1,admin2

REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tele_autoupload

STAGING_DIR=/tmp/tele-staging
UPLOAD_STRATEGY=drive_desktop

DRIVE_ROOT_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_SYNC_FOLDER=/tmp/drive-sync
UPLOAD_DATE_BUCKET_ENABLED=true
UPLOAD_DATE_BUCKET_DAYS=5
PLAYWRIGHT_PROFILE_DIR=

UPLOAD_CONCURRENCY=6
UPLOAD_RATE_LIMIT_PER_SEC=10
UPLOAD_MAX_RETRIES=8
UPLOAD_INITIAL_BACKOFF_MS=10000

MAX_STAGING_SIZE_GB=50
HIGH_WATERMARK_PCT=80
CLEANUP_AFTER_HOURS=2
RECONCILIATION_INTERVAL_MIN=10
# Reconciliation is leased and bounded so scheduled runs cannot overlap.
RECONCILIATION_LEASE_TTL_MS=540000
RECONCILIATION_LEASE_RENEWAL_MS=30000
RECONCILIATION_RUN_BUDGET_MS=480000
RECONCILIATION_STALE_BUDGET_MS=60000
RECONCILIATION_MAX_CHATS_PER_RUN=500
RECONCILIATION_MAX_PAGES_PER_CHAT=3
RECONCILIATION_HISTORY_PAGE_SIZE=100
RECONCILIATION_NORMAL_LOOKBACK_MESSAGES=50
RECONCILIATION_RECOVERY_LOOKBACK_MESSAGES=200
RECONCILIATION_CHAT_CONCURRENCY=3
RECONCILIATION_TELEGRAM_REQUESTS_PER_SEC=5
# Shared Redis-backed Telegram request permit expiry. Active calls renew it.
TELEGRAM_REQUEST_SLOT_TTL_MS=120000

# Download work runs separately from ingestion/reconciliation.
DOWNLOAD_CONCURRENCY=3
DOWNLOAD_MAX_RETRIES=8
DOWNLOAD_INITIAL_BACKOFF_MS=10000
# Refreshes active download state so a legitimate long download is not reclaimed as stale.
DOWNLOAD_HEARTBEAT_MS=60000

STATS_API_PORT=3100
STATS_API_AUTH_TOKEN=dev-token
STATS_RETENTION_DAYS=90
ADMIN_WEB_USERNAME=xxxx
ADMIN_WEB_PASSWORD=xxxx
